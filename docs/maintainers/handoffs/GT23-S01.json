{
  "task_id": "GT23-S01",
  "status": "ready_for_independent_review",
  "scientific_approval": false,
  "last_checked_at_utc": "2026-11-24T00:13:45+00:00",
  "summary": "Own GT23 segmentation for all 488 recordings, run as 4 pilots, 12 participant batches and 1 summary job under the guarded launcher (one at a time, peak 133-170 MiB). All 13,119 authors' windows are accounted (matched or missed with a reason); all 90 recordings without windows have one disposition (23 gait, 3 window, 64 continuous). Gait tasks reproduce the authors' strides exactly where the plate exists (start and end offset 0 ms for every matched window). Window-rule tasks (speed crossing) match starts only within 0-250 ms and their ends differ by about a second, because our rule yields separate spans where the authors have one window. Independent audit not yet done.",
  "decisions_applied": [
    "D-GT23-C01-2: own segmentation for all 488 recordings, checked against the authors' windows",
    "D-GT23-C01-1 = C: forward and sideways only for the 11 forward-walking tasks (a force-frame matter for C06; S01 only records the task)"
  ],
  "module": "contributor_tools/gt23_segmentation.py (pure rules) and contributor_tools/run_gt23_s01.py (run, spec, summary)",
  "rules": {
    "gait (normal_walk, dynamic_walk, incline_walk, weighted_walk, walk_backward, stairs, obstacle_walk, side_shuffle)": "stride = rising crossing of 20 N (first sample at or above 20 N) to the same leg's next rising crossing, left plate for left and right plate for right; an interval is excluded with a reason if it contains missing force, is shorter than 0.3 s or longer than 5 s; the final contact is listed as excluded (no following contact). Right-plate-missing recordings give zero right records.",
    "window, pelvis markers (ball_toss, curb_down, curb_up, cutting, jump, lunges, sit_to_stand, squats, step_ups, tire_run, turn_and_step) and trunk markers C7+STRN (lift_weight)": "span where the speed of the mean of the markers (central difference over 50 ms) is at or above 0.5 m/s; dips shorter than 0.25 s bridged only if measured; spans shorter than 0.25 s, open at the recording edge or next to a missing marker are excluded with a reason",
    "continuous (meander, poses, push, start_stop, tug_of_war, twister)": "continuous recording, no strides",
    "unknown task": "stops the job (UnknownTask), no default"
  },
  "fixed_in_advance_parameters": "20 N; 0.3 s and 5 s stride limits; 0.5 m/s; 50 ms difference span; 0.25 s debounce; match tolerance 50 ms (gait) and 250 ms (window), start time. None tuned to the agreement.",
  "deviation_from_plan": "side_shuffle uses the gait rule (README lists shuffling under 20 N heel strike), not the window rule. It does not reproduce the authors' windows (1 and 4 of 150 matched).",
  "label_rule": "A record carries an authors' file name (label_source=authors_window) only if it matches an authors' window within the tolerance; every other record has label_source=unknown. No speed, incline or weight label is inferred. Speed/incline parsing from file names is E01's job.",
  "jobs": {
    "pilots": {
      "AB12 normal_walk_1": "pilot-nw",
      "AB01 stairs_1_2": "pilot-stairs",
      "AB12 poses_1": "pilot-poses",
      "AB11 squats_1": "pilot-squats"
    },
    "batches": "gt23_s01_batch_<AB..>",
    "summary": "converted_datasets/reconversion_v2/gt23_s01_summary/summary.json",
    "specs_and_receipts": "docs/quality/audits/gt23-s01-<job>-spec.json and -launcher-receipt.json (every job: clean_success true, verify-cleanup proof true)",
