File_New
;

! Directory where the original files are located
Set_Pipeline_Parameter_To_Folder_Path
/PARAMETER_NAME=FOLDER
/PARAMETER_VALUE=
! /PARAMETER_VALUE_SEARCH_FOR=
! /PARAMETER_VALUE_REPLACE_WITH=
! /PARAMETER_VALUE_APPEND=
;

!Set the Pipeline parameter according to the analyzed subject
Set_Pipeline_Parameter
/PARAMETER_NAME=subjIDX  
/PARAMETER_VALUE=WBDS01 
; 

Create_Hybrid_Model
/CALIBRATION_FILE=::FOLDER&::subjIDX&static1.c3d
! /RANGE=ALL_FRAMES
;

Apply_Model_Template
/MODEL_TEMPLATE=::FOLDER&WBDSmodel.mdh
/CALIBRATION_FILE=::FOLDER&::subjIDX&static1.c3d
;

Set_Subject_Mass
/CALIBRATION_FILE=::FOLDER&::subjIDX&static1.c3d
/WEIGHT=74.3
;

Set_Subject_Height
/CALIBRATION_FILE=::FOLDER&::subjIDX&static1.c3d
/HEIGHT=172.5
;

Open_File
/FILE_NAME=::FOLDER&::subjIDX&walkO*.c3d
;

Assign_Model_File
/CALIBRATION_FILE=::FOLDER&::subjIDX&static1.c3d
/MOTION_FILE_NAMES=::FOLDER&::subjIDX&walkO*.c3d
! /REMOVE_EXISTING_ASSIGNMENTS=FALSE
;

