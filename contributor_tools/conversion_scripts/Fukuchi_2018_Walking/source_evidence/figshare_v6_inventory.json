v"}], "folder_structure": {}, "authors": [{"id": 4690387, "full_name": "Claudiane Fukuchi", "first_name": "Claudiane", "last_name": "Fukuchi", "is_active": true, "url_name": "Claudiane_Fukuchi", "orcid_id": ""}, {"id": 3630580, "full_name": "Reginaldo Fukuchi", "first_name": "Reginaldo", "last_name": "Fukuchi", "is_active": true, "url_name": "Reginaldo_Fukuchi", "orcid_id": "0000-0003-3113-7715"}, {"id": 2796493, "full_name": "Marcos Duarte", "first_name": "Marcos", "last_name": "Duarte", "is_active": true, "url_name": "Marcos_Duarte", "orcid_id": "0000-0002-0344-7460"}], "custom_fields": [], "figshare_url": "https://figshare.com/articles/dataset/A_public_data_set_of_overground_and_treadmill_walking_kinematics_and_kinetics_of_healthy_individuals/5722711", "download_disabled": false, "description": "<p dir=\"ltr\">The data set comprises raw and processed (both in c3d and txt formats) pelvis and lower extremity kinematics and kinetics signals of 51 healthy volunteers (24 young adults and 27 older adults) walking in both overground and treadmill in a range of gait speeds. A file of metadata (csv), including anthropometrics and information related to each file in the data set is also provided. In addition, a model file (mdh) and a pipeline file (v3s) for the Visual 3D software program are also provided.</p><p dir=\"ltr\">The data were collected using a three-dimensional (3D) motion-capture system, force platforms and an instrumented treadmill while the subjects walked barefoot over a range of gait speeds.</p>", "funding": "FAPESP/Brazil (#2014/13502-7, #2015/14810-0)", "funding_list": [{"id": 274640, "title": "FAPESP/Brazil (#2014/13502-7, #2015/14810-0)", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 6, "status": "public", "size": 2238113177, "created_date": "2026-09-13T11:36:59Z", "modified_date": "2026-09-13T11:37:00Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["gait", "biomechanics", "kinematics", "kinetics", "human movement", "Biomechanics", "Biomechanical Engineering"], "keywords": ["gait", "biomechanics", "kinematics", "kinetics", "human movement", "Biomechanics", "Biomechanical Engineering"], "categories": [{"id": 24484, "title": "Clinical microbiology", "parent_id": 24475, "path": "/24457/24475/24484", "source_id": "320203", "taxonomy_id": 100}, {"id": 26272, "title": "Biomechanical engineering", "parent_id": 26263, "path": "/26212/26263/26272", "source_id": "400303", "taxonomy_id": 100}], "references": ["https://peerj.com/articles/4640/"], "has_linked_file": false, "citation": "Fukuchi, Claudiane; Fukuchi, Reginaldo; Duarte, Marcos (2018). A public data set of overground and treadmill walking kinematics and kinetics of healthy individuals. figshare. Dataset. https://doi.org/10.6084/m9.figshare.5722711.v6", "related_materials": [{"id": 214019195, "identifier": "https://peerj.com/articles/4640/", "title": "", "relation": "References", "identifier_type": "URL", "is_linkout": false, "link": "https://peerj.com/articles/4640/"}], "is_embargoed": false, "embargo_date": null, "embargo_type": "file", "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 5722711, "title": "A public data set of overground and treadmill walking kinematics and kinetics of healthy individuals", "doi": "10.6084/m9.figshare.5722711.v6", "handle": "", "url": "https://api.figshare.com/v2/articles/5722711", "published_date": "2026-09-13T11:36:59Z", "thumb": "", "defined_type": 3, "defined_type_name": "dataset", "group_id": null, "url_private_api": "https://api.figshare.com/v2/account/articles/5722711", "url_public_api": "https://api.figshare.com/v2/articles/5722711", "url_private_html": "https://figshare.com/account/articles/5722711", "url_public_html": "https://figshare.com/articles/dataset/A_public_data_set_of_overground